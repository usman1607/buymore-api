{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "Enabled": true,
    "CaptureRequestBody": false,
    "MaxStoredEntries": 200
  },
  "Mail": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "username",
    "Password": "password",
    "FromEmail": "noreply@example.com",
    "FromName": "BuyMore Notifications"
  },
  "Notification": {
    "EmailEnabled": true,
    "LogEnabled": true
  },
  "Paystack": {
    "SecretKey": "pk_test_replace_with_secret",
    "PublicKey": "pk_test_replace_with_public",
    "BaseUrl": "https://api.paystack.co"
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "Storage",
      "OverwriteExisting": false
    },
    "Aws": {
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1",
      "BucketName": ""
    },
    "Azure": {
      "ConnectionString": "",
      "ContainerName": ""
    }
  },
  "AllowedHosts": "*"
}
